PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/voting
FIREBASE_PROJECT_ID=your-firebase-project-id
CORS_ORIGIN=*
LOG_LEVEL=debug
APP_URL=http://localhost:3000

# Optional — invite emails are sent via Resend (https://resend.com).
# Without these set, the server logs invites instead of sending them.
RESEND_API_KEY=
EMAIL_FROM="Voting Stage <onboarding@resend.dev>"
